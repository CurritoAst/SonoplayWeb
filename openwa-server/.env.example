# Copia este fichero a .env y rellena los valores
# Puerto donde escucha el servicio (luego lo proteges con firewall / nginx)
PORT=3000

# Token secreto compartido con el PHP (api/_common.php → WA_API_TOKEN).
# Pon una cadena larga y aleatoria. DEBE coincidir en ambos lados.
WA_TOKEN=pon-aqui-un-secreto-largo-y-aleatorio

# Nombre de la sesión de WhatsApp (deja SONOPLAY salvo que tengas varias)
WA_SESSION=SONOPLAY
